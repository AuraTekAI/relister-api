# Copy to monitoring/uptime.env on the machine that runs uptime_check.py
# (NOT the production server). uptime.env is gitignored.
UPTIME_WEBSITE_URL=https://autorelister.com.au/
UPTIME_API_URL=https://api.autorelister.com.au/api/login/
UPTIME_TIMEOUT_SECONDS=15
UPTIME_FAILURES_BEFORE_ALERT=2
UPTIME_NOTIFY_RECOVERY=1
# Comma-separated recipients
KAZ_AND_TEAM=kazp@citysubaru.com.au
# Flashpost — same values as the backend .env
DEFAULT_FROM_EMAIL=hello@autorelister.com.au
FLASHPOST_API_URL=
FLASHPOST_API_KEY=
