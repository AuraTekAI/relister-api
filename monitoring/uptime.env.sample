# Copy to monitoring/uptime.env on the machine that runs uptime_check.py
# (NOT the production server). uptime.env is gitignored.
UPTIME_WEBSITE_URL=https://autorelister.com.au/
UPTIME_API_URL=https://api.autorelister.com.au/api/login/
# Redis is pinged from the web process by this endpoint (no Celery involved)
UPTIME_REDIS_URL=https://api.autorelister.com.au/api/team-alerts/health/?component=redis
UPTIME_TIMEOUT_SECONDS=15
UPTIME_FAILURES_BEFORE_ALERT=2
UPTIME_NOTIFY_RECOVERY=1
# Comma-separated recipients
KAZ_AND_TEAM=kazp@citysubaru.com.au
# Flashpost — same values as the backend .env
DEFAULT_FROM_EMAIL=hello@autorelister.com.au
FLASHPOST_API_URL=
FLASHPOST_API_KEY=
# Amazon SES fallback — the redis alert is sent through SES, never Flashpost
# (same values as the backend .env; falls back to Flashpost if left empty)
ALERT_FALLBACK_SES_REGION=
ALERT_FALLBACK_SES_ACCESS_KEY_ID=
ALERT_FALLBACK_SES_SECRET_ACCESS_KEY=
ALERT_FALLBACK_SES_FROM_EMAIL=
